# Copy to .env and fill in. Never commit .env.

# ── AI model (OpenRouter) ─────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys. Empty = "modo básico" (no AI, keyword answers).
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# ── First admin account ───────────────────────────────────────────────
# If ADMIN_PASSWORD is empty, a random one is saved to data/admin_password.txt on first start.
ADMIN_EMAIL=admin@islasantarem.pt
ADMIN_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────
# Empty = generated once and kept in data/.secret_key
SECRET_KEY=
# true when served over HTTPS
COOKIE_SECURE=false
CHAT_RATE_LIMIT_PER_HOUR=60

# ── School website crawler ────────────────────────────────────────────
SITE_BASE_URL=https://www.islasantarem.pt
CRAWL_ENABLED=true
CRAWL_INTERVAL_HOURS=12
CRAWL_MAX_PAGES=150
CRAWL_MAX_PDFS=60

SCHOOL_NAME=ISLA Santarém
SCHOOL_CONTACT=Secretaria: secretaria@islasantarem.pt · +351 243 330 820
